        "q.bedrock('camerupt_dawnian', 'empty_ride')",
        "q.bedrock_stateful('camerupt_dawnian', 'blink')"
      ],
      "transformTicks": 5,
      "transformToTicks": 5
    },
    "standing": {
      "poseTypes": ["STAND", "FLOAT", "NONE", "PORTRAIT", "PROFILE"],
      "condition": "!q.in_air",
      "animations": [
        "q.look('head')",
        "q.bedrock('camerupt_dawnian', 'ground_idle')",
        "q.bedrock_stateful('camerupt_dawnian', 'blink')"
      ],
      "transformTicks": 5
    },
    "walk": {
      "poseTypes": ["WALK", "SWIM"],
      "condition": "!q.in_air && !q.is_sprinting",
      "animations": [
        "q.bedrock('camerupt_dawnian', 'ground_walk')",
        "q.bedrock_stateful('camerupt_dawnian', 'blink')",
        {
          "condition": "q.is_ridden && q.has_entity && !q.in_air",
          "animation": "q.bedrock('camerupt_dawnian', 'empty_ride')"
        }
      ],
      "transformTicks": 5
    },
    "run": {
      "poseTypes": ["WALK", "SWIM"],
      "condition": "!q.in_air && q.is_sprinting",
      "animations": [
        "q.bedrock('camerupt_dawnian', 'ground_run')",
        "q.bedrock_stateful('camerupt_dawnian', 'blink')",
        {
          "condition": "q.is_ridden && q.has_entity && !q.in_air",
          "animation": "q.bedrock('camerupt_dawnian', 'ride_ground_run')"
        }
      ],
      "transformTicks": 5
    },
    "battle-standing": {
      "poseTypes": ["STAND"],
      "isBattle": true,
      "animations": [
        "q.bedrock('camerupt_dawnian', 'battle_idle')"
      ],
      "quirks": ["q.bedrock_quirk('camerupt_dawnian', 'blink')"]
    },
    "float": {
      "poseTypes": ["FLOAT"],
      "animations": [
        "q.bedrock('camerupt_dawnian', 'ground_idle')"
      ]
    },
    "swim": {
      "poseTypes": ["SWIM"],
      "animations": [
        "q.bedrock('camerupt_dawnian', 'ground_walk')"
      ]
    },
    "sleep": {
      "poseTypes": ["SLEEP"],
      "animations": ["q.bedrock('camerupt_dawnian', 'sleep')"]
